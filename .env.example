# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# Database
DATABASE_URL=postgresql://byteverse:password@localhost:5432/byteverse

# Redis
REDIS_URL=redis://localhost:6379

# Judge0
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=your-judge0-key
JUDGE0_WEBHOOK_SECRET=your-webhook-secret-min-32-chars

# AI Gateway (supports comma-separated key pool for rotation)
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEYS=gsk_key1,gsk_key2,gsk_key3,gsk_key4,gsk_key5
AI_API_KEY=gsk_fallback_single_key
AI_MODEL=llama-3.1-8b-instant
AI_EXPLAIN_MODEL=llama-3.1-8b-instant
AI_CODE_MODEL=llama-3.1-8b-instant
AI_MAX_TOKENS=800
AI_RATE_LIMIT_PER_MINUTE=10

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin
ADMIN_EMAIL=admin@byteverse.dev

# Observability
LOG_LEVEL=info
