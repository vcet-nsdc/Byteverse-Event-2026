# App
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Database (app)
DATABASE_URL=postgresql://byteverse:${POSTGRES_PASSWORD}@postgres:5432/byteverse
POSTGRES_PASSWORD=generate-strong-password

# Database (judge0 — separate instance)
JUDGE0_DB_PASSWORD=generate-strong-password

# Redis
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=generate-strong-password

# Judge0
JUDGE0_URL=http://judge0:2358
JUDGE0_API_KEY=
JUDGE0_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# Admin PIN — used by proctors to unlock anti-cheat screen
# Must be set; no fallback defaults exist
ADMIN_PIN=choose-a-strong-numeric-or-alphanumeric-pin

# AI Gateway (supports comma-separated key pool for rotation)
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEYS=gsk_key1,gsk_key2,gsk_key3
AI_API_KEY=gsk_fallback_single_key
AI_MODEL=llama-3.1-8b-instant
AI_EXPLAIN_MODEL=llama-3.1-8b-instant
AI_CODE_MODEL=llama-3.1-8b-instant
AI_MAX_TOKENS=800
AI_RATE_LIMIT_PER_MINUTE=10

# Public
NEXT_PUBLIC_EVENT_ID=byteverse-2026

# Admin
ADMIN_EMAIL=admin@your-domain.com

# Observability
LOG_LEVEL=info
