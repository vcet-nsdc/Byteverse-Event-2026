generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  ORGANIZER
  ADMIN
  SUPER_ADMIN
}

enum TeamStatus {
  PENDING
  ACTIVE
  LOCKED
  DISQUALIFIED
}

enum RoundType {
  CODE_LOGIC
  AI_REPAIR
  TRADITIONAL
  TYPE_TRANSFORM
  HUMAN_VS_MACHINE
}

enum RoundStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
  SYSTEM_ERROR
}

enum AIType {
  EXPLAIN
  CODE
}

enum MissingMemberPolicy {
  TREAT_AS_ZERO
  MARK_INCOMPLETE
  TEAM_INELIGIBLE
  REQUIRE_BOTH
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  college       String?   @default("NSDC College")
  passwordHash     String?
  role             Role      @default(PARTICIPANT)
  round4ProblemId  String?
  round5ProblemId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  teamMember          TeamMember?
  submissions         Submission[]
  aiUsages            AIUsage[]
  roundScores         RoundScore[]
  disqualification    Disqualification?
  auditLogs           AuditLog[]
  discussions         Discussion[]
  discussionComments  DiscussionComment[]
  discussionVotes     DiscussionVote[]
  contestParticipants ContestParticipant[]

  @@index([email])
  @@map("users")
}

model Team {
  id         String     @id @default(cuid())
  name       String     @unique
  inviteCode String     @unique @default(cuid())
  status           TeamStatus @default(PENDING)
  isLocked         Boolean    @default(false)
  round4ProblemId  String?
  round5ProblemId  String?
  eventId          String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  event            Event              @relation(fields: [eventId], references: [id])
  members          TeamMember[]
  teamScores       TeamScore[]
  disqualification Disqualification?

  @@index([inviteCode])
  @@index([eventId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String   @unique
  isLeader  Boolean  @default(false)
  joinedAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("team_members")
}

model Event {
  id                   String              @id @default(cuid())
  name                 String
  description          String?
  bannerUrl            String?
  venue                String?             @default("Campus Auditorium & Labs")
  category             String?             @default("Championship")
  startsAt             DateTime?
  endsAt               DateTime?
  registrationOpen     Boolean             @default(true)
  teamRegistrationOpen Boolean             @default(true)
  isActive             Boolean             @default(false)
  missingMemberPolicy  MissingMemberPolicy @default(TREAT_AS_ZERO)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  rounds        Round[]
  teams         Team[]
  announcements Announcement[]
  contests      Contest[]

  @@map("events")
}

model Round {
  id               String      @id @default(cuid())
  eventId          String?
  contestId        String?
  name             String
  type             RoundType
  status           RoundStatus @default(DRAFT)
  sequence         Int
  durationMin      Int         @default(60)
  startsAt         DateTime?
  endsAt           DateTime?
  maxScore         Int         @default(100)
  aiExplainPenalty Int         @default(75)
  aiCodePenalty    Int         @default(50)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  event       Event?       @relation(fields: [eventId], references: [id])
  contest     Contest?     @relation(fields: [contestId], references: [id])
  problems    Problem[]
  submissions Submission[]
  roundScores RoundScore[]
  teamScores  TeamScore[]

  @@unique([eventId, sequence])
  @@index([eventId])
  @@index([contestId])
  @@map("rounds")
}

model Problem {
  id                 String   @id @default(cuid())
  roundId            String?
  contestId          String?
  title              String
  statement          String
  inputFormat        String?
  outputFormat       String?
  constraints        String?
  sampleInput        String?
  sampleOutput       String?
  difficulty         String?  @default("Easy")
  tags               String[] @default([])
  timeLimitMs        Int      @default(2000)
  memoryLimitMb      Int      @default(256)
  allowedLangs       String[] @default(["cpp", "c", "java", "python"])
  isPublished        Boolean  @default(true)
  set                String   @default("A")
  starterCodes       Json?
  options            Json?
  correctOption      String?
  aiAnalysisReport   Json?
  sequence           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  round       Round?       @relation(fields: [roundId], references: [id])
  contest     Contest?     @relation(fields: [contestId], references: [id])
  testCases   TestCase[]
  submissions Submission[]
  discussions Discussion[]

  @@index([roundId])
  @@index([contestId])
  @@map("problems")
}

model TestCase {
  id        String   @id @default(cuid())
  problemId String
  input      String
  expected   String
  isHidden   Boolean  @default(false)
  isEdgeCase Boolean  @default(false)
  score      Int      @default(0)
  sequence   Int      @default(1)
  createdAt  DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@map("test_cases")
}

model Submission {
  id              String           @id @default(cuid())
  userId          String
  problemId       String
  roundId         String?
  contestId       String?
  language        String
  sourceCode      String
  status          SubmissionStatus @default(QUEUED)
  rawScore        Float            @default(0)
  finalScore      Float            @default(0)
  aiScoreCap      Int              @default(100)
  isFinal         Boolean          @default(false)
  analysisReport  Json?
  executionTimeMs Int?
  memoryUsedMb    Float?
  judgeToken      String?
  idempotencyKey  String           @unique
  submittedAt     DateTime         @default(now())
  judgedAt        DateTime?

  user    User     @relation(fields: [userId], references: [id])
  problem Problem  @relation(fields: [problemId], references: [id])
  round   Round?   @relation(fields: [roundId], references: [id])
  contest Contest? @relation(fields: [contestId], references: [id])

  @@index([userId, roundId])
  @@index([problemId])
  @@index([roundId])
  @@index([contestId])
  @@index([judgeToken])
  @@map("submissions")
}

model AIUsage {
  id         String   @id @default(cuid())
  userId     String
  roundId    String
  problemId  String?
  type       AIType
  prompt     String
  response   String?
  tokensUsed Int?
  usedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, roundId])
  @@index([userId, problemId])
  @@index([userId, type])
  @@map("ai_usages")
}

model RoundScore {
  id          String    @id @default(cuid())
  userId      String
  roundId     String
  rawScore    Float     @default(0)
  finalScore  Float     @default(0)
  aiScoreCap  Int       @default(100)
  explainUsed     Boolean   @default(false)
  codeUsed        Boolean   @default(false)
  completedAt     DateTime?
  durationSeconds Int?
  updatedAt       DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  round Round @relation(fields: [roundId], references: [id])

  @@unique([userId, roundId])
  @@index([roundId])
  @@index([userId])
  @@map("round_scores")
}

model TeamScore {
  id           String   @id @default(cuid())
  teamId       String
  roundId      String
  member1Score Float    @default(0)
  member2Score Float?
  avgScore     Float    @default(0)
  updatedAt    DateTime @updatedAt

  team  Team  @relation(fields: [teamId], references: [id])
  round Round @relation(fields: [roundId], references: [id])

  @@unique([teamId, roundId])
  @@index([teamId])
  @@map("team_scores")
}

model Disqualification {
  id             String   @id @default(cuid())
  userId         String?  @unique
  teamId         String?  @unique
  reason         String
  disqualifiedBy String
  disqualifiedAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
  team Team? @relation(fields: [teamId], references: [id])

  @@map("disqualifications")
}

model Announcement {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  body      String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("announcements")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Contest {
  id          String      @id @default(cuid())
  title       String
  description String?
  type        String      @default("WEEKLY") // "WEEKLY", "BIWEEKLY", "COLLEGE", "CHALLENGE"
  status      RoundStatus @default(SCHEDULED)
  startsAt    DateTime
  endsAt      DateTime
  bannerUrl   String?
  difficulty  String?     @default("Mixed")
  eventId     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  event        Event?               @relation(fields: [eventId], references: [id])
  rounds       Round[]
  problems     Problem[]
  submissions  Submission[]
  participants ContestParticipant[]

  @@index([eventId])
  @@index([status])
  @@map("contests")
}

model ContestParticipant {
  id           String   @id @default(cuid())
  contestId    String
  userId       String
  score        Float    @default(0)
  rank         Int?
  registeredAt DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([contestId])
  @@index([userId])
  @@map("contest_participants")
}

model Discussion {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  problemId String?
  tags      String[] @default([])
  views     Int      @default(0)
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  problem  Problem?            @relation(fields: [problemId], references: [id], onDelete: SetNull)
  comments DiscussionComment[]
  votes    DiscussionVote[]

  @@index([authorId])
  @@index([problemId])
  @@index([createdAt])
  @@index([upvotes])
  @@map("discussions")
}

model DiscussionComment {
  id           String   @id @default(cuid())
  content      String
  discussionId String
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([authorId])
  @@map("discussion_comments")
}

model DiscussionVote {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  value        Int      // 1 for upvote, -1 for downvote
  createdAt    DateTime @default(now())

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@index([discussionId])
  @@index([userId])
  @@map("discussion_votes")
}

